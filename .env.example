# ============================
# CHEFPACK MICROSERVICES CONFIG
# ============================

# Environment
NODE_ENV=development
API_VERSION=v1

# ============================
# DATABASES (Separate DBs per domain)
# ============================

# Auth & Users Database
DATABASE_AUTH_URL=postgresql://postgres:password@localhost:5432/chefpack_auth?schema=public

# Orders Database
DATABASE_ORDERS_URL=postgresql://postgres:password@localhost:5433/chefpack_orders?schema=public

# Payments & Payouts Database
DATABASE_PAYMENTS_URL=postgresql://postgres:password@localhost:5434/chefpack_payments?schema=public

# Cooks, Menu & Plans Database
DATABASE_COOKS_URL=postgresql://postgres:password@localhost:5435/chefpack_cooks?schema=public

# ============================
# REDIS
# ============================
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ============================
# OBJECT STORAGE (R2/S3)
# ============================
S3_ENDPOINT=https://your-account.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=your_access_key
S3_SECRET_ACCESS_KEY=your_secret_key
S3_BUCKET=chefpack-media
S3_REGION=auto

# ============================
# SEARCH (Meilisearch)
# ============================
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=masterKey

# ============================
# EVENT BUS & QUEUE (BullMQ)
# ============================
QUEUE_REDIS_URL=redis://localhost:6379
QUEUE_PREFIX=chefpack

# ============================
# JWT & AUTH
# ============================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-refresh-token-secret
JWT_REFRESH_EXPIRES_IN=30d
OTP_EXPIRY_MINUTES=10
SESSION_SECRET=your-session-secret

# ============================
# AWS SNS (SMS)
# ============================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
SNS_SENDER_ID=ChefPack

# ============================
# AWS SES (Email)
# ============================
SES_FROM_EMAIL=noreply@chefpack.com
SES_FROM_NAME=ChefPack

# ============================
# FIREBASE FCM (Push Notifications)
# ============================
FCM_SERVER_KEY=your_fcm_server_key
FCM_PROJECT_ID=your_firebase_project_id

# ============================
# SHIPPACK DELIVERY API
# ============================
SHIPPACK_API_URL=https://api.shippack.com/v1
SHIPPACK_API_KEY=your_shippack_api_key
SHIPPACK_WEBHOOK_SECRET=your_shippack_webhook_secret

# ============================
# PAYMENT PROVIDER (Stripe/Paystack)
# ============================
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ============================
# MAPS (OpenStreetMap/Nominatim)
# ============================
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_EMAIL=your-email@example.com

# ============================
# MONITORING (Sentry)
# ============================
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_ENVIRONMENT=development

# ============================
# CLOUDFLARE
# ============================
CLOUDFLARE_ZONE_ID=your_zone_id
CLOUDFLARE_API_TOKEN=your_api_token

# ============================
# API GATEWAY
# ============================
GATEWAY_PORT=3000
GATEWAY_RATE_LIMIT_WINDOW_MS=900000
GATEWAY_RATE_LIMIT_MAX_REQUESTS=100

# ============================
# MICROSERVICES PORTS
# ============================
AUTH_SERVICE_PORT=3001
USERS_SERVICE_PORT=3002
COOKS_SERVICE_PORT=3003
MENU_SERVICE_PORT=3004
PLANS_SERVICE_PORT=3005
ORDERS_SERVICE_PORT=3006
MATCHING_SERVICE_PORT=3007
INGREDIENTS_SERVICE_PORT=3008
DISPATCH_SERVICE_PORT=3009
PAYMENTS_SERVICE_PORT=3010
PAYOUTS_SERVICE_PORT=3011
NOTIFICATIONS_SERVICE_PORT=3012
SUPPORT_SERVICE_PORT=3013
RATINGS_SERVICE_PORT=3014
WEBHOOK_SERVICE_PORT=3015

# ============================
# INTERNAL SERVICE URLS
# ============================
AUTH_SERVICE_URL=http://localhost:3001
USERS_SERVICE_URL=http://localhost:3002
COOKS_SERVICE_URL=http://localhost:3003
MENU_SERVICE_URL=http://localhost:3004
PLANS_SERVICE_URL=http://localhost:3005
ORDERS_SERVICE_URL=http://localhost:3006
MATCHING_SERVICE_URL=http://localhost:3007
INGREDIENTS_SERVICE_URL=http://localhost:3008
DISPATCH_SERVICE_URL=http://localhost:3009
PAYMENTS_SERVICE_URL=http://localhost:3010
PAYOUTS_SERVICE_URL=http://localhost:3011
NOTIFICATIONS_SERVICE_URL=http://localhost:3012
SUPPORT_SERVICE_URL=http://localhost:3013
RATINGS_SERVICE_URL=http://localhost:3014
WEBHOOK_SERVICE_URL=http://localhost:3015

# ============================
# CORS
# ============================
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

